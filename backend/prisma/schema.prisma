// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}


model Task {
  id        Int      @id @default(autoincrement())
  identity  String
  problem   String
  action    String
  result    String
  repetitions Int
  date      DateTime?
  startedAt DateTime?
  timeSpent Float    @default(0)
  started   Boolean  @default(false)
  completed Boolean  @default(false)
  archived  Boolean  @default(false)
  
  // Relationships to individual components
  identityRef Identity? @relation(fields: [identityId], references: [id])
  identityId  Int?
  
  problemRef Problem? @relation(fields: [problemId], references: [id])
  problemId  Int?
  
  actionRef Action? @relation(fields: [actionId], references: [id])
  actionId  Int?
  
  resultRef Result? @relation(fields: [resultId], references: [id])
  resultId  Int?
}

// Individual attribute models
model Identity {
  id          Int      @id @default(autoincrement())
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship back to tasks
  tasks Task[]
}

model Problem {
  id          Int      @id @default(autoincrement())
  description String
  category    String?
  priority    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship back to tasks
  tasks Task[]
}

model Action {
  id          Int      @id @default(autoincrement())
  description String
  type        String?
  duration    Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship back to tasks
  tasks Task[]
}

model Result {
  id          Int      @id @default(autoincrement())
  description String
  outcome     String?
  metrics     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relationship back to tasks
  tasks Task[]
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
